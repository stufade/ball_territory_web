{
  // Cloudflare: Worker раздаёт игру из public/ и держит комнаты в Durable Objects (бесплатный план)
  "name": "ball-territory",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Stats"] }],
  // имя бота без @ и короткое имя Mini App из BotFather; без них приглашение даёт обычную ссылку на сайт
  "vars": { "BOT_USERNAME": "ChooseYourElementBot", "APP_NAME": "" }
}
